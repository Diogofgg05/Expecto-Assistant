# Copy to .env (the launch scripts load it automatically)
AURA_HOST=127.0.0.1
AURA_PORT=8000
AURA_DATA_DIR=./data
AURA_OLLAMA_URL=http://127.0.0.1:11434
AURA_OLLAMA_MODEL=hermes3
# 5.4: keep model in RAM between conversation turns (0m unloads immediately).
# Set 0m if RAM is scarce; 10m can reduce cold-load delays.
AURA_OLLAMA_KEEP_ALIVE=10m
# OPTIONAL: running SearXNG instance configured to support JSON
AURA_SEARXNG_URL=
# Research jobs run only after you explicitly enable a topic via voice or text.
AURA_RESEARCH_INTERVAL_HOURS=24
# Synthesize spoken responses in the browser after messages.
AURA_VOICE_OUTPUT=true
# OPTIONAL local voice in 5.5. Install Whisper.cpp CLI + a PT/multilingual ggml .bin model,
# and/or Piper CLI + a Portuguese ONNX voice (with matching .onnx.json).
# Audio is processed only on localhost and never sent to a cloud service by Expecto.
# AURA_VOICE_WHISPER_BINARY=C:/tools/whisper/whisper-cli.exe
# AURA_VOICE_WHISPER_MODEL=C:/tools/whisper/models/ggml-base.bin
# AURA_VOICE_PIPER_BINARY=C:/tools/piper/piper.exe
# AURA_VOICE_PIPER_MODEL=C:/tools/piper/voices/pt_PT-voice.onnx
# Optional 5.7: reuse a Python Piper ONNX session between phrases (faster warm TTS).
# Install in the same Python environment: python -m pip install piper-tts
# Requires model.onnx AND model.onnx.json. Uses more RAM while Expecto runs.
# AURA_VOICE_PIPER_INPROCESS=true

# MEMÓRIA EPISÓDICA: 6 meses completos de contexto pesquisável.
# As mensagens nunca são eliminadas automaticamente; estes meses definem
# apenas a janela de recuperação. A app guarda conversas normais por omissão.
AURA_MEMORY_MONTHS=6
AURA_EPISODIC_CAPTURE=true
# Backup consistente local a cada 7 dias (enquanto a app é executada).
AURA_MEMORY_BACKUP_DAYS=7

# Opcional: pesquisa semântica de memórias. Instala: ollama pull qwen3-embedding:0.6b
# Descomentando a linha seguinte ativas embeddings locais (sem serviços de nuvem).
# AURA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# AURA 2.3: indexação semântica de conversas de seis meses
# INSTALA PRIMEIRO: ollama pull qwen3-embedding:0.6b
# AURA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Extração local automática: usa AURA_OLLAMA_MODEL (precisa de Ollama ligado)
AURA_AUTO_EXTRACT_MEMORY=true
AURA_MEMORY_WORKER_SECONDS=45

# AURA 2.4: memória temporal técnica automática fica ativa apenas quando
# AURA_EPISODIC_CAPTURE e AURA_AUTO_EXTRACT_MEMORY estão ambas ligadas.
# Não requer Ollama para reconhecer frases técnicas simples.

# AURA 2.5: relacionar automaticamente afirmações literais sobre projetos.
# Só age quando AURA_EPISODIC_CAPTURE e AURA_AUTO_EXTRACT_MEMORY também estão ativas.
AURA_AUTO_LINK_MEMORY=true

# AURA 2.6: consolidação de notas e conversas em resumos com fontes.
# Por segurança é opt-in; ativa por voz: "Ativa consolidação automática".
# Sem Ollama, sem apagar notas, sem misturar versões temporais como contradições.
AURA_AUTO_CONSOLIDATE_MEMORY=false

# AURA 2.8 — Proteção da base ativa:
# NÃO guardar AURA_DATABASE_PASSPHRASE aqui.
# O iniciar_aura.bat/launch.py pede a chave em cada arranque.
# Para converter dados da versão 2.7: python -m aura.vault migrate ...
# A instalação recusa abrir ficheiro SQLite sem cifragem ou chave inválida.
# AURA_BACKUP_PASSPHRASE também é solicitada em cada arranque se necessário.

# AURA 2.9: motor avançado com opt-in pelo comando de voz/texto
# Diz: "Ativa aprendizagem avançada" para investigação periódica com extração
# Só processa tópicos agendados através de "Investiga autonomamente sobre ..."
# Para uma investigação pontual: "Aprende profundamente sobre ..."
# É necessário Ollama ligado para extrair novas hipóteses.

# AURA 3.0: DSPy facultativo. NÃO executa aprendizagem em background.
# Instala: install_optimizer_windows.bat, depois
# .venv\Scripts\python.exe -m aura.optimizer train --method labeled
# Aprovação explícita, apenas se passar os critérios: "Aprova otimização <ID>"
# Rollback: "Reverte estratégia"
# O sistema só envia ao Ollama dados do benchmark artificial, nunca memórias privadas.

# AURA 3.3: para verificar uma fonte pública ao vivo, pede por voz:
# "Verifica factos <ID>" — apenas Wikipédia portuguesa; NÃO há scraping livre.
# "Estado da verificação factual" abre os relatórios no espaço de pesquisa.
# Ver docs/FACTCHECK_33.md. Não envia automaticamente memórias privadas.

# Expecto 5.2: pesquisa externa somente por SearXNG loopback (desativada por predefinição)
# AURA_SEARXNG_URL=http://127.0.0.1:8080
# AURA_REASONING_MODEL=nome-do-modelo-ollama-local
